HOST=0.0.0.0
PORT=3000
DATABASE_PATH=data/kanjiwritr.sqlite
# Generate once with: openssl rand -base64 32
CREDENTIAL_SECRET=replace-with-a-long-random-secret
# Keep enabled in production. Set to false for unlimited local testing.
RATE_LIMITS_ENABLED=true
# Enable only when the origin is reachable exclusively through Cloudflare.
TRUST_CLOUDFLARE_PROXY=false
PAIRING_RATE_LIMIT_MAX=8
PAIRING_RATE_LIMIT_WINDOW_SECONDS=3600
CLAIM_RATE_LIMIT_MAX=20
CLAIM_RATE_LIMIT_WINDOW_SECONDS=600
WEBSOCKET_RATE_LIMIT_MAX=40
WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=60
# Chromium extension builds default to localhost unless this is set.
KANJIWRITR_DEFAULT_SERVER_URL=https://kanjiwritr.example
