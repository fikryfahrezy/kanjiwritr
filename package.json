{
  "name": "kanjiwrittr",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --parallel dev:web dev:server",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "WEB_ROOT=apps/web/dist bun --watch apps/server/src/index.ts",
    "build": "bun run build:web && bun run build:server && bun run build:extension",
    "build:web": "bun run --cwd apps/web build",
    "build:server": "bun build apps/server/src/index.ts --target=bun --outdir dist/server",
    "build:extension": "bun run --cwd apps/extension build",
    "start": "bun dist/server/index.js",
    "test": "bun test",
    "test:integration": "bun scripts/integration-smoke.ts",
    "typecheck": "bun run typecheck:web && bun run typecheck:server && bun run typecheck:extension",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:server": "bun run --cwd apps/server typecheck",
    "typecheck:extension": "bun run --cwd apps/extension typecheck"
  }
}
